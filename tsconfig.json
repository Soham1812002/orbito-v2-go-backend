{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": [
    "services/**/*.ts",
    "shared/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts",
    "prettier.config.ts",
    "eslint.config.ts"
  ],
  "exclude": ["services/backend/src/browser"]
}
