# Application settings (host processes)
NODE_ENV=development
DATABASE_URL=postgres://fleet:replace-database-password@localhost:5432/fleet
PUBLIC_ORIGIN=http://localhost
PORT=3000
REALTIME_PORT=3001
API_URL=http://localhost:3000
REALTIME_URL=http://localhost:3001
# Generate independent values with: openssl rand -hex 32
GATEWAY_SECRET=replace-with-independent-random-secret-at-least-32-characters
REALTIME_SECRET=replace-with-another-random-secret-at-least-32-characters
ALLOW_UNVERIFIED_MARKON=false
TRUST_PROXY=false
SPOOL_DIR=./data/spool
SPOOL_MAX_BYTES=1073741824

# Docker Compose settings. Internal service URLs and ports are fixed in compose.yaml.
# Compose uses an internal DB URL; use a URL-safe random hex password.
POSTGRES_PASSWORD=replace-with-random-hex-password

# Optional isolated demo workspace used only by the smoke service.
DEMO_EMAIL=demo@fleet.local
DEMO_PASSWORD=replace-with-a-random-password-at-least-12-characters

# Operational logging: all levels by default; host files survive container replacement.
LOG_LEVEL=trace
LOG_HOST_DIR=./logs
# Set to the host operator group ID on Linux for read access.
LOG_GID=1000
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5
LOG_RETENTION_DAYS=7
