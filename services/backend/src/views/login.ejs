<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />
    <title>Sign in · Fleet</title>
    <link
      rel="stylesheet"
      href="/assets/style.css"
    />
    <script
      src="/assets/login.js"
      type="module"
    ></script>
  </head>
  <body class="login-page">
    <main class="login-card">
      <span class="eyebrow">FLEET OPERATIONS</span>
      <h1>Welcome back.</h1>
      <p>Sign in to manage vehicles and inspect device messages.</p>
      <form id="login">
        <label>
          Email
          <input
            name="email"
            type="email"
            autocomplete="username"
            required
            maxlength="254"
          />
        </label>
        <label>
          Password
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            required
            maxlength="256"
          />
        </label>
        <p
          id="message"
          role="status"
        ></p>
        <button type="submit">Sign in</button>
      </form>
      <small>Access is restricted to registered team members.</small>
    </main>
  </body>
</html>
