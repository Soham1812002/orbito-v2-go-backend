<!doctype html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main>
      <p class="eyebrow">WORKSPACE / <%= page === 'vehicles' ? 'REGISTRY' : 'DIAGNOSTICS' %></p>
      <div
        id="message"
        role="status"
        aria-live="polite"
      ></div>
      <div class="page-title">
        <div>
          <h1>Your fleet</h1>
          <p>Register vehicles, connect trackers and keep their identity in one place.</p>
        </div>
        <% if(user.role !== 'viewer') { %>
        <button id="add-vehicle">+ Add vehicle</button>
        <% } %>
      </div>
      <section class="panel">
        <div class="toolbar">
          <h2>Vehicle registry</h2>
          <form id="search-form">
            <input
              id="search"
              aria-label="Search vehicles"
              placeholder="Search name, plate or IMEI"
            />
            <button class="secondary">Search</button>
          </form>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Vehicle</th>
                <th>Device / IMEI</th>
                <th>Profile</th>
                <th>Activity</th>
                <th>Last communication</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="vehicles">
              <tr>
                <td colspan="6">Loading vehicles…</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="toolbar">
          <span id="vehicle-count"></span>
          <button
            id="more-vehicles"
            class="secondary"
            hidden
          >
            Next page
          </button>
          <button
            id="first-vehicles"
            class="secondary"
            hidden
          >
            First page
          </button>
        </div>
      </section>
      <aside class="note">
        Registering a tracker does not configure its hardware. Set the device's server address and
        port using its manufacturer's supported procedure. IMEI identifies a tracker; it is not
        proof of authenticity.
      </aside>
      <dialog id="vehicle-dialog">
        <form id="vehicle-form">
          <div class="toolbar">
            <h2 id="form-title">Add vehicle</h2>
            <button
              type="button"
              class="secondary"
              id="close-dialog"
            >
              Close
            </button>
          </div>
          <div class="form-grid">
            <label>
              Vehicle name
              <input
                name="name"
                required
                maxlength="100"
                placeholder="Delivery Van 1"
              />
            </label>
            <label>
              Vehicle number
              <input
                name="registrationNumber"
                required
                maxlength="32"
                placeholder="GJ 01 AB 1234"
              />
            </label>
            <label>
              Vehicle type
              <select name="vehicleType">
                <option value="van">Van</option>
                <option value="car">Car</option>
                <option value="truck">Truck</option>
                <option value="bus">Bus</option>
                <option value="other">Other</option>
              </select>
            </label>
            <label class="device-field">
              IMEI
              <input
                name="imei"
                required
                inputmode="numeric"
                pattern="[0-9]{15}"
                minlength="15"
                maxlength="15"
                placeholder="15 digits"
              />
            </label>
            <label class="device-field">
              Protocol profile
              <select
                name="profileId"
                id="profile"
                aria-label="Protocol profile"
                required
              ></select>
            </label>
            <label class="device-field">
              Device model
              <input
                name="model"
                required
                maxlength="80"
                placeholder="Model printed on hardware"
              />
            </label>
            <label class="device-field">
              Firmware
              <input
                name="firmware"
                maxlength="80"
                placeholder="Unknown if not supplied"
              />
            </label>
            <label class="device-field">
              Expected activity interval (seconds)
              <input
                type="number"
                name="expectedInterval"
                value="60"
                min="5"
                max="86400"
                required
              />
            </label>
          </div>
          <label>
            Notes
            <textarea
              name="notes"
              rows="3"
              maxlength="1000"
            ></textarea>
          </label>
          <label class="checkbox">
            <input
              name="enabled"
              type="checkbox"
              checked
            />
            Enabled
          </label>
          <p
            class="note"
            id="profile-note"
          ></p>
          <p
            id="form-error"
            role="alert"
          ></p>
          <button
            id="save-vehicle"
            type="submit"
          >
            Save vehicle
          </button>
        </form>
      </dialog>
      <dialog id="assignment-dialog">
        <form id="assignment-form">
          <h2>Replace tracker</h2>
          <p>
            Choose a registered, unassigned tracker. Earlier logs keep their original vehicle
            association.
          </p>
          <label>
            Registered unassigned tracker
            <select id="replacement-device">
              <option value="">Register a new tracker below</option>
            </select>
          </label>
          <div class="form-grid">
            <label>
              New tracker IMEI
              <input
                id="replacement-imei"
                inputmode="numeric"
                pattern="[0-9]{15}"
                maxlength="15"
              />
            </label>
            <label>
              Model
              <input
                id="replacement-model"
                maxlength="80"
              />
            </label>
            <label>
              Profile
              <select id="replacement-profile"></select>
            </label>
            <label>
              Firmware (optional)
              <input
                id="replacement-firmware"
                maxlength="80"
              />
            </label>
          </div>
          <p
            id="assignment-error"
            role="alert"
          ></p>
          <div class="toolbar">
            <button type="submit">Assign now</button>
            <button
              id="close-assignment"
              type="button"
              class="secondary"
            >
              Cancel
            </button>
          </div>
        </form>
      </dialog>
    </main>
    <script
      type="module"
      src="/assets/vehicles.js"
    ></script>
  </body>
</html>
