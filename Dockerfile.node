FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json npm-shrinkwrap.json ./
COPY apps/backend-api/package.json apps/backend-api/package.json
COPY apps/realtime-server/package.json apps/realtime-server/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json ./
COPY packages ./packages
COPY apps/backend-api ./apps/backend-api
COPY apps/realtime-server ./apps/realtime-server
COPY scripts ./scripts
USER node
CMD ["node","--import","tsx","apps/backend-api/src/server.ts"]
