events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 80;
    server_name ${FLEET_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://${FLEET_DOMAIN}$request_uri; }
  }
  server {
    listen 443 ssl;
    server_name ${FLEET_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${FLEET_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FLEET_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    location ^~ /internal/ { return 404; }
    location ^~ /health/ { return 404; }
    location /socket.io/ {
      proxy_pass http://realtime:3001;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header Origin $http_origin;
      proxy_set_header X-Forwarded-Proto https;
      proxy_read_timeout 75s;
    }
    location / {
      proxy_pass http://api:3000;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto https;
    }
  }
}
